{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/.gemini/config/scripts/set_tab_title.py --hook \"🛡️ adblocker\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/.gemini/config/scripts/set_tab_title.py --hook \"🛡️ adblocker\""
          }
        ]
      }
    ]
  },
  "project-tab-title": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "/home/user/.gemini/config/scripts/set_tab_title.py --hook \"🛡️ adblocker\"",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "/home/user/.gemini/config/scripts/set_tab_title.py --hook \"🛡️ adblocker\"",
        "timeout": 5
      }
    ]
  }
}
